# Copy this file to .env.dev / .env.staging / .env.prod and fill it in per environment.
# Pick the target at run time with TEST_ENV (default: dev):
#
#   npx playwright test                     # dev
#   TEST_ENV=staging npx playwright test    # staging
#
# .env.* files are gitignored. In CI, set these as environment variables instead
# (dotenv will not override a value that is already set).

# Base URL of the system under test.
# Required for staging/prod; dev falls back to the known dev host if left blank.
BASE_URL=

# Test account, used only by account / logged-in specs
# (@/fixtures/account/account.fixture.ts). The logged-out suites ignore these.
USER_EMAIL=
USER_PASSWORD=
